body {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
}

#hud {
    width: 100%;
    height: 100%;
    font-family: "Open Sans";
}

/* ── Shared panel structure ── */

.panel {
    position: absolute;
    width: 160dp;
    height: 80dp;
}

.panel-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 160dp;
    height: 80dp;
}

.panel-label {
    position: absolute;
    top: 10dp;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 13dp;
    color: #ffffff;
    z-index: 1;
}

.panel-value {
    position: absolute;
    top: 34dp;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 26dp;
    font-weight: bold;
    color: #ffffff;
    z-index: 1;
}

/* ── Panel positions ── */

#score-panel {
    top: 20dp;
    right: 20dp;
}
