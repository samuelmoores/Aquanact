body {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
}

#hud {
    width: 100%;
    height: 100%;
    font-family: "Open Sans";
    font-size: 16px;
    color: #ffffff;
}

/* ── Health bar (bottom-left) ── */
#health-container {
    position: absolute;
    left: 24px;
    bottom: 24px;
    width: 200px;
}

#health-label {
    display: block;
    font-size: 13px;
    color: #cccccc;
    margin-bottom: 4px;
}

#health-bar-bg {
    display: block;
    width: 200px;
    height: 16px;
    background-color: #333333;
    border-radius: 4px;
}

#health-bar-fill {
    display: block;
    width: 75%;
    height: 16px;
    background-color: #e74c3c;
    border-radius: 4px;
}

/* ── Score (top-right) ── */
#score-container {
    position: absolute;
    right: 24px;
    top: 24px;
    text-align: right;
}

#score-label {
    display: block;
    font-size: 13px;
    color: #cccccc;
}

#score-value {
    display: block;
    font-size: 28px;
    font-weight: bold;
    color: #f1c40f;
}

/* ── Crosshair (center) ── */
#crosshair {
    position: absolute;
    width: 40px;
    height: 40px;
    left: 50%;
    top: 50%;
    margin-left: -20px;
    margin-top: -20px;
}

.crosshair-h {
    display: block;
    position: absolute;
    width: 40px;
    height: 4px;
    top: 18px;
    background-color: #ffffff;
}

.crosshair-v {
    display: block;
    position: absolute;
    width: 4px;
    height: 40px;
    left: 18px;
    background-color: #ffffff;
}
